---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Slide from '../components/Slide.astro';
import MovieCard from '../components/MovieCard.astro';
import movies from '../data/movies.json';
---

<Layout title="Featured" htmlId="main-overview" currentNav="featured">
    <main class="content-grid">
        <div class="content-grid-before"></div>
        <div class="content-grid-after"></div>
        <h1>What to watch</h1>
        <Carousel>
            {movies.map((movie, index) => (
                <Slide>
                    <MovieCard movie={movie} transitionName={`movie-${movie.slug}`} />
                </Slide>
            ))}
        </Carousel>

        <h1>Editor Picks</h1>
        <Carousel>
            {movies.map((movie) => (
                <Slide>
                    <MovieCard movie={movie} />
                </Slide>
            ))}
        </Carousel>
    </main>
</Layout>
