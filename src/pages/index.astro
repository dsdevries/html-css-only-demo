---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Slide from '../components/Slide.astro';
import MovieCard from '../components/MovieCard.astro';
import movies from '../data/movies.json';
---

<Layout title="Featured" htmlId="main-overview" currentNav="featured">
    <main class="content-grid">
        <h1>What to watch</h1>
        <Carousel>
            {movies.filter(movie => movie.featured).slice(0,10).map((movie) => (
                <Slide>
                    <MovieCard movie={movie} />
                </Slide>
            ))}
        </Carousel>

        <h1>Editor Picks</h1>
        <Carousel>
            {movies.filter(movie => movie['editor-pick']).slice(0,10).map((movie) => (
                <Slide>
                    <MovieCard movie={movie} />
                </Slide>
            ))}
        </Carousel>
    </main>
</Layout>

<style is:global>
    /* Scoped styles cannot target the html element or the elements rendered by
       MovieCard, so these page level rules are declared globally. */

    #main-overview {
        position: relative;

        &::view-transition-new(.movie-poster) {
            object-fit: contain;
        }

        &::view-transition-old(.movie-poster) {
            object-fit: cover;
            z-index: 4;
        }

        .details {
            display: none;
        }
    }
</style>
