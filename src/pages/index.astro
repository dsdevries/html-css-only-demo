---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Slide from '../components/Slide.astro';
import MovieCard from '../components/MovieCard.astro';
import movies from '../data/movies.json';
---

<Layout title="Featured" htmlId="main-overview" currentNav="featured">
    <style is:global>
        #lion-king-poster {
            view-transition-name: main-image;
        }
    </style>

    <main class="content-grid">
        <h1>What to watch</h1>
        <Carousel>
            {movies.map((movie) => (
                <Slide>
                    <MovieCard movie={movie} imageId={movie.slug === 'lion-king' ? 'lion-king-poster' : undefined} />
                </Slide>
            ))}
        </Carousel>

        <h1>Editor Picks</h1>
        <Carousel>
            {movies.map((movie) => (
                <Slide>
                    <MovieCard movie={movie} />
                </Slide>
            ))}
        </Carousel>
    </main>
</Layout>
