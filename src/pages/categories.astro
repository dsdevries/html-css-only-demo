---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Categories" htmlId="categories" currentNav="categories">
    <main class="content-grid">
        <ul class="masonry categories">
            <li class="card radius-large glass-container-mild category-action">
                <img src="https://images.unsplash.com/photo-1594909122845-11baa439b7bf?auto=format&fit=crop&q=80&w=400" alt="Action" />
                <div class="details">
                    <h3>Action</h3>
                </div>
            </li>
            <li class="card double-height glass-container-mild category-comedy">
                <img src="https://images.unsplash.com/photo-1585647347483-22b66260dfff?auto=format&fit=crop&q=80&w=400" alt="Comedy" />
                <div class="details">
                    <h3>Comedy</h3>
                </div>
            </li>
            <li class="card radius-large glass-container-mild category-family">
                <img src="https://images.unsplash.com/photo-1478720568477-152d9b164e26?auto=format&fit=crop&q=80&w=400" alt="Family" />
                <div class="details">
                    <h3>Family</h3>
                </div>
            </li>
            <li class="card radius-large glass-container-mild category-sci-fi">
                <img src="https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?auto=format&fit=crop&q=80&w=400" alt="Sci-Fi" />
                <div class="details">
                    <h3>Sci-Fi</h3>
                </div>
            </li>
            <li class="card double-height radius-large glass-container-mild category-classics">
                <img src="https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&q=80&w=400" alt="Classics" />
                <div class="details">
                    <h3>Classics</h3>
                </div>
            </li>
            <li class="card radius-large glass-container-mild category-thriller">
                <img src="https://images.unsplash.com/photo-1477332552946-cfb384aeaf1c?auto=format&fit=crop&q=80&w=400" alt="Thriller" />
                <div class="details">
                    <h3>Thriller</h3>
                </div>
            </li>
            <li class="card radius-large glass-container-mild category-horror">
                <img src="https://images.unsplash.com/photo-1509248961158-e54f6934749c?auto=format&fit=crop&q=80&w=400" alt="Horror" />
                <div class="details">
                    <h3>Horror</h3>
                </div>
            </li>
        </ul>
    </main>
</Layout>

<style>
    .masonry {
        display: grid;
        display: grid-lanes;
        grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
        gap: var(--padding-inline);
        margin: 0;
        padding: 0;
    }

    .categories {
        .card {
            animation: 300ms cubic-bezier(0, 0, 0.2, 1) both fade-in-up;
            animation-delay: calc(sibling-index() * 100ms);
            width: 100%;
            height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            box-shadow: 0 4px 12px var(--color-black-08);
            position: relative;
            overflow: hidden;

            @supports (display: grid-lanes) {
                &.double-height {
                    height: calc(300px + 2rem);
                }
            }

            img {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 1;
                opacity: 0.4;
                mix-blend-mode: multiply;
            }

            .details {
                position: relative;
                z-index: 2;
            }

            h3 {
                font-size: 1.5rem;
                color: var(--color-white);
                text-shadow: 0 1px 10px var(--color-black-60);
                margin: 0;
            }
        }

        .category-action {
            background: linear-gradient(to bottom, var(--color-category-action-1), var(--color-category-action-2) 30%, var(--color-category-action-3));
        }

        .category-comedy {
            background: linear-gradient(to bottom, var(--color-category-comedy-1), var(--color-category-comedy-2) 30%, var(--color-category-comedy-3));
        }

        .category-family {
            background: linear-gradient(to bottom, var(--color-category-family-1), var(--color-category-family-2) 30%, var(--color-category-family-3));
        }

        .category-sci-fi {
            background: linear-gradient(to bottom, var(--color-category-sci-fi-1), var(--color-category-sci-fi-2) 30%, var(--color-category-sci-fi-3));
        }

        .category-classics {
            background: linear-gradient(to bottom, var(--color-category-classics-1), var(--color-category-classics-2) 30%, var(--color-category-classics-3));
        }

        .category-thriller {
            background: linear-gradient(to bottom, var(--color-category-thriller-1), var(--color-category-thriller-2) 30%, var(--color-category-thriller-3));
        }

        .category-horror {
            background: linear-gradient(to bottom, var(--color-category-horror-1), var(--color-category-horror-2) 30%, var(--color-category-horror-3));
        }
    }
</style>
