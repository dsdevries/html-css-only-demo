---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Slide from '../components/Slide.astro';
import MovieCard from '../components/MovieCard.astro';
import movies from '../data/movies.json';

const heroMovie = movies.find((m) => m.slug === 'lion-king') || movies[0];
---

<Layout title="New" htmlId="new-overview" currentNav="new">
    <main class="content-grid snap-top">
        <div class="hero full-width">
            <img src={heroMovie.image} alt={heroMovie.title} />

            <div class="content content-grid">
                <h1>{heroMovie.title}</h1>
                <div class="rating">{heroMovie.rating}</div>
                <p>
                    {heroMovie.description}
                </p>
                <button class="button radius-medium">Watch now ▶</button>
            </div>
        </div>
        <h1>Newest releases</h1>
        <Carousel>
            {movies.map((movie) => (
                <Slide>
                    <MovieCard movie={movie} />
                </Slide>
            ))}
        </Carousel>
    </main>
</Layout>
