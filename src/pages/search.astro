---
import Layout from '../layouts/Layout.astro';
import SearchResults from '../components/SearchResults.astro';
import SearchResultsSkeleton from '../components/SearchResultsSkeleton.astro';
import StreamFlush from '../components/StreamFlush.astro';

export const prerender = false;

const query = Astro.url.searchParams.get('q')?.toLowerCase() || '';
---

<Layout title="Search" htmlId="search" currentNav="search" breakoutHeader={true}>
    <link rel="expect" href="#skeleton-ready" blocking="render" slot="head">
    
    <style is:inline slot="head">
        /* Force native view transitions to be active */
        @view-transition { navigation: auto; }

        /* Critical View Transition names for the search page */
        /* Moving these here ensures they are available for the very first paint, */
        /* which is essential for native view transitions to work correctly. */
        .search-input-wrapper { view-transition-name: search-field; }
        #search-title { view-transition-name: search-title; }
        .search-results-wrapper { view-transition-name: search-results; }

        /* The search field fades in from below when entering this page.
           :only-child means there is no matching old snapshot, i.e. the previous
           page had no search field. When refining a search we come from the
           search page itself, the old and new snapshots are paired, the
           pseudo-elements are siblings and these rules no longer match, so the
           field simply morphs instead of fading in again. */
        ::view-transition-new(search-field):only-child {
            animation: 300ms cubic-bezier(0, 0, 0.2, 1) both fade-in-up;
            animation-delay: 0.5s;
        }

        ::view-transition-old(search-field):only-child {
            animation: 300ms cubic-bezier(0.4, 0, 1, 1) both fade-out;
        }
    </style>

    <main class="content-grid snap-top">
        <div class="hero breakout search-hero radius-large">
            <form class="search-form" role="search" action="/search" method="get">
                <div class="search-input-wrapper glass-container radius-large">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                    <input type="search" name="q" placeholder="Search movies, TV shows, actors..." class="search-field" autocomplete="off" value={query} />
                    <button type="submit" class="button radius-medium">Search</button>
                </div>
            </form>
        </div>

        <div id="search-content-area">
            <h1 id="search-title">{query ? `Search results for "${query}"` : 'Search results'}</h1>

            <div id="search-results-container" class="search-results-wrapper">
                <div class="skeleton-list search-results">
                    <SearchResultsSkeleton />
                </div>
                <div id="skeleton-ready"></div>
                <StreamFlush />
                <SearchResults query={query} />
            </div>
        </div>
    </main>
</Layout>

<style is:global>
    /* Scoped styles cannot target the html element or the elements rendered by
       SearchResults, SearchResultsSkeleton and MovieCard, so these page level
       rules are declared globally. */

    .search-input-wrapper {
        view-transition-name: search-field;
    }

    #search-title {
        view-transition-name: search-title;
    }

    .search-results-wrapper {
        view-transition-name: search-results;
    }

    /* When this component finishes streaming, we fade out the skeletons */
    .search-results-wrapper:has(.results-done) .skeleton-list {
        animation: fade-out 0.4s 0.1s forwards !important;
        pointer-events: none !important;
    }

    /* Ensure the results list itself fades in only when fully loaded */
    .results-list {
        opacity: 0;
    }

    .search-results-wrapper:has(.results-done) .results-list {
        animation: fade-in 0.4s 0.1s forwards !important;
    }

    #search {
        .search-hero {
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1b1035 0%, #3b1d60 40%, #7e22ce 75%, #db2777 100%);
            background: linear-gradient(random(0deg, 360deg), #1b1035 0%, #3b1d60 random(20%, 45%), #7e22ce random(65%, 80%), #db2777 100%);
            border-radius: var(--radius-large);
            padding: 3rem 1rem;
            box-sizing: border-box;
            min-height: 350px;
        }

        .search-form {
            width: 100%;
            max-width: 600px;
            display: flex;
            justify-content: center;
        }

        .search-input-wrapper {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem 0.5rem 1.25rem;
            box-sizing: border-box;
            backdrop-filter: none;
        }

        .search-icon {
            flex-shrink: 0;
            color: var(--color-text-primary);
            opacity: 0.7;
        }

        .search-field {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            font-size: 1.1rem;
            color: var(--color-text-primary);
            font-family: inherit;
            min-width: 0;

            &::placeholder {
                color: var(--color-text-primary);
                opacity: 0.6;
            }
        }


        .search-results-wrapper {
            display: grid;
            grid-template-columns: 1fr;
            margin: 1.5rem 0 5rem;

            & > * {
                grid-area: 1 / 1;
            }
        }

        .search-results {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;

            .card {
                animation: fade-in-up linear both;
                animation-timeline: view();
                animation-range: entry 10% cover 30%;
                will-change: transform, opacity;

                .rating {
                    margin: 0.5rem 0;
                }

                a {
                    width: 175px;
                }

                p {
                    margin: 0.5rem 0 1rem;
                    line-height: 1.5;
                    min-height: 4.5em;
                    color: var(--color-text-primary);
                    opacity: 0.9;
                }

                .cast {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 1.5rem;

                    .name {
                        font-weight: bold;
                        font-size: 0.9rem;
                    }

                    .role {
                        font-size: 0.8rem;
                        opacity: 0.7;
                    }
                }
            }
        }
    }
</style>
