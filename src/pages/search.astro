---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search" htmlId="search" currentNav="search" breakoutHeader={true}>
    <main class="content-grid snap-top">
        <div class="hero breakout search-hero radius-large">
            <form class="search-form" role="search" action="/search" method="get">
                <div class="search-input-wrapper glass-container radius-large">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                    <input type="search" name="q" placeholder="Search movies, TV shows, actors..." class="search-field" autocomplete="off" />
                    <button type="submit" class="button radius-medium">Search</button>
                </div>
            </form>
        </div>

        <h1>Search results</h1>
        <ul class="search-results">
            <li class="card radius-large glass-container-mild">
                <a href="/detail">
                    <img src="/assets/lion-king.webp" alt="Mufasa: The Lion King" />
                </a>
                <div class="details">
                    <h3>Mufasa: The Lion King</h3>
                    <div class="rating">⭐️⭐️⭐️⭐️</div>
                    <p>
                        Mufasa, a cub lost and alone, meets a sympathetic lion named
                        Taka, the heir to a royal bloodline. The chance meeting sets in motion an
                        expansive journey of a group of misfits searching for their destiny.
                    </p>
                    <div class="cast">
                        <div>
                            <div class="name">Barry Jenkins</div>
                            <div class="role">Director</div>
                        </div>
                        <div>
                            <div class="name">Jeff Nathanson</div>
                            <div class="role">Screenplay</div>
                        </div>
                    </div>
                </div>
            </li>
            <li class="card radius-large glass-container-mild">
                <a>
                    <img src="/assets/gladiator.webp" alt="Gladiator II" />
                </a>
                <div class="details">
                    <h3>Gladiator II</h3>
                    <div class="rating">⭐️⭐️⭐️</div>
                    <p>
                        Years after witnessing the death of the revered hero Maximus at
                        the hands of his uncle, Lucius is forced to enter the Colosseum after his home is conquered.
                    </p>
                    <div class="cast">
                        <div>
                            <div class="name">Ridley Scott</div>
                            <div class="role">Director</div>
                        </div>
                        <div>
                            <div class="name">David Scarpa</div>
                            <div class="role">Screenplay, Story</div>
                        </div>
                    </div>
                </div>
            </li>
            <li class="card radius-large glass-container-mild">
                <a>
                    <img src="/assets/flow.jpeg" alt="Flow" />
                </a>
                <div class="details">
                    <h3>Flow</h3>
                    <div class="rating">⭐️⭐️⭐️⭐️⭐️</div>
                    <p>
                        A solitary cat, displaced by a great flood, finds refuge on a boat with various species, having to learn how to cooperate despite their differences.
                    </p>
                    <div class="cast">
                        <div>
                            <div class="name">Gints Zilbalodis</div>
                            <div class="role">Director, Screenplay</div>
                        </div>
                        <div>
                            <div class="name">Matīss Kaža</div>
                            <div class="role">Screenplay</div>
                        </div>
                    </div>
                </div>
            </li>
            <li class="card radius-large glass-container-mild">
                <a>
                    <img src="/assets/sonic.webp" alt="Sonic the Hedgehog 3" />
                </a>
                <div class="details">
                    <h3>Sonic the Hedgehog 3</h3>
                    <div class="rating">⭐️⭐️⭐️⭐️</div>
                    <p>
                        Sonic, Knuckles, and Tails reunite against a powerful new adversary, Shadow, a mysterious villain with powers unlike anything they have faced before.
                    </p>
                    <div class="cast">
                        <div>
                            <div class="name">Patrick Casey</div>
                            <div class="role">Screenplay, Story</div>
                        </div>
                        <div>
                            <div class="name">Josh Miller</div>
                            <div class="role">Screenplay, Story</div>
                        </div>
                    </div>
                </div>
            </li>
        </ul>
    </main>
</Layout>
