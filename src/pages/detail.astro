---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Featured" htmlId="main-detail" currentNav="featured" showBackButton={true} breakoutHeader={true} backHref="/">
    <style is:global>
        #lion-king-poster {
            view-transition-name: main-image;
        }
    </style>

    <main class="content-grid snap-top">
        <div class="hero breakout">
            <img id="lion-king-poster" class="radius-large" src="/assets/lion-king.webp" alt="Mufasa: The Lion King" />

            <div class="content content-grid radius-large">
                <h1>Mufasa: The Lion King</h1>
                <div class="rating">⭐️⭐️⭐️⭐️</div>
                <p>
                    Mufasa, a cub lost and alone, meets a sympathetic lion named Taka, the
                    heir to a royal bloodline. The chance meeting sets in motion an
                    expansive journey of a group of misfits searching for their destiny.
                </p>
                <button class="button radius-medium">Watch now ▶</button>
            </div>
        </div>
        <h1>Related content</h1>
        <div class="carousel">
            <ul class="movies">
                <li class="card" data-image="/assets/gladiator.webp">
                    <a>
                        <img class="radius-large" src="/assets/gladiator.webp" alt="Gladiator II" />
                    </a>
                    <div class="details">
                        <h3>Gladiator II</h3>
                        <div class="rating">⭐️⭐️⭐️</div>
                        <p>
                            Years after witnessing the death of the revered hero Maximus at
                            the hands of his uncle, Lucius is forced...
                        </p>
                        <div class="cast">
                            <div>
                                <div class="name">David Scarpa</div>
                                <div class="role">Screenplay, Story</div>
                            </div>
                            <div>
                                <div class="name">David Franzoni</div>
                                <div class="role">Characters</div>
                            </div>
                            <div>
                                <div class="name">Ridley Scott</div>
                                <div class="role">Director</div>
                            </div>
                            <div>
                                <div class="name">Peter Craig</div>
                                <div class="role">Story</div>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="card" data-image="/assets/lion-king.webp">
                    <a href="/detail">
                        <img class="radius-large" src="/assets/lion-king.webp" alt="Mufasa: The Lion King" />
                    </a>
                    <div class="details">
                        <h3>Mufasa: The Lion King</h3>
                        <div class="rating">⭐️⭐️⭐️⭐️</div>
                        <p>
                            Mufasa, a cub lost and alone, meets a sympathetic lion named
                            Taka, the heir to a royal bloodline...
                        </p>
                        <div class="cast">
                            <div>
                                <div class="name">Barry Jenkins</div>
                                <div class="role">Director</div>
                            </div>
                            <div>
                                <div class="name">Jeff Nathanson</div>
                                <div class="role">Screenplay</div>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="card" data-image="/assets/flow.jpeg">
                    <a>
                        <img class="radius-large" src="/assets/flow.jpeg" alt="Flow" />
                    </a>
                    <div class="details">
                        <h3>Flow</h3>
                        <div class="rating">⭐️⭐️⭐️⭐️⭐️</div>
                        <p>
                            A solitary cat, displaced by a great flood, finds refuge on a
                            boat with various species...
                        </p>
                        <div class="cast">
                            <div>
                                <div class="name">Gints Zilbalodis</div>
                                <div class="role">Director, Screenplay</div>
                            </div>
                            <div>
                                <div class="name">Matīss Kaža</div>
                                <div class="role">Screenplay</div>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="card" data-image="/assets/sonic.webp">
                    <a>
                        <img class="radius-large" src="/assets/sonic.webp" alt="Sonic the Hedgehog 3" />
                    </a>
                    <div class="details">
                        <h3>Sonic the Hedgehog 3</h3>
                        <div class="rating">⭐️⭐️⭐️⭐️</div>
                        <p>
                            Sonic, Knuckles, and Tails reunite against a powerful new
                            adversary, Shadow, a mysterious villain...
                        </p>
                        <div class="cast">
                            <div>
                                <div class="name">Patrick Casey</div>
                                <div class="role">Screenplay, Story</div>
                            </div>
                            <div>
                                <div class="name">Josh Miller</div>
                                <div class="role">Screenplay, Story</div>
                            </div>
                            <div>
                                <div class="name">Naoto Ohshima</div>
                                <div class="role">Characters</div>
                            </div>
                            <div>
                                <div class="name">Hirokazu Yasuhara</div>
                                <div class="role">Characters</div>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </main>
</Layout>
