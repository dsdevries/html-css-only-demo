---
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  showBackButton?: boolean;
  breakout?: boolean;
  backHref?: string;
}

const { showBackButton = false, breakout = false, backHref = '/' } = Astro.props;
---

<header class="content-grid">
    <div class:list={["logo", { breakout: !showBackButton && breakout }]}>
        <a href="/">
            <img src="/assets/logo.svg" alt="Cinema Flow Logo" />
        </a>
    </div>
    {showBackButton && (
        <a href={backHref} class="button back-button breakout radius-round" aria-label="Go back">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
            </svg>
        </a>
    )}
    <div class:list={["profile", { breakout }]}>
        <button class="button profile-button radius-round" popovertarget="profile-menu">
            <img class="radius-round" src="/assets/avatar.png" alt="Profile avatar" />
        </button>
        <nav class="profile-menu glass-container" popover="auto" id="profile-menu">
            <ul>
                <li><a href="profile.html">Profile</a></li>
                <li><a href="settings.html">Settings</a></li>
                <li class="theme-switch-container">
                    <ThemeSwitch />
                </li>
                <li><a href="logout.html">Logout</a></li>
            </ul>
        </nav>
    </div>
</header>

<style>
    header {
        width: 100%;
        z-index: 1000;
        padding-block: 2rem;
        container-type: scroll-state;
        position: sticky;
        top: 0;
        padding: 2rem 0 2rem;
        box-sizing: border-box;
        overflow: clip;

        &::after {
            content: "";
            position: absolute;
            display: block;
            top: -1px;
            left: -1px;
            bottom: 1rem;
            right: -1px;
            grid-column: full-width;

            background: var(--glass-panel-medium);
            backdrop-filter: blur(var(--blur-heavy));
            box-shadow:
                    0 4px 10px 0 var(--color-black-10),
                    var(--glass-edge);

            opacity: 0;
            transition: opacity 0.4s ease-in-out;
            z-index: -1;

            @container scroll-state(stuck: top) {
                opacity: 1;
            }

            /* Safari does not support scroll-state queries yet, so there the
               stuck state is read from --header-stuck, which the scroll driven
               fallback animation below flips. */
            @container style(--header-stuck: true) {
                opacity: 1;
            }
        }

        /* The main element is rendered by the page, so it has to be global */
        & ~ :global(main.snap-top) {
            margin-top: -116px;
        }

        .logo {
            view-transition-name: logo;
            grid-column: content;
            grid-row: 1;
            justify-self: start;
            align-self: center;
            z-index: 100;
            margin-left: 0;

            /* The scoped selector outweighs the global .content-grid > .breakout
               rule, so the column has to be set here as well. */
            &.breakout {
                grid-column: breakout;
                margin-left: 1rem;
            }

            header:has(.back-button) & {
                margin-left: clamp(0rem, (1110px - 100vw) * 0.5, 5rem);
            }

            img {
                height: 48px;
                width: auto;
                display: block;
            }
        }

        .back-button {
            view-transition-name: back-button;
            grid-column: content;
            grid-row: 1;
            justify-self: start;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            color: var(--color-text-primary);
            text-decoration: none;
            z-index: 100;

            &.breakout {
                grid-column: breakout;
                margin-left: 1rem;
            }

            svg {
                width: 24px;
                height: 24px;
                overflow: visible;
                filter: var(--icon-filter);
            }
        }
    }

    /* Fallback for browsers without scroll-state container queries (Safari).
       The header sits at the very top of the page, so "stuck: top" is the same
       as "the page is scrolled": a scroll driven animation flips the registered
       --header-stuck custom property, which is inherited by the ::after
       backdrop and picked up by the style query above. The property is discrete,
       so it switches at once and the opacity transition keeps running. */
    @supports not (container-type: scroll-state) {
        header {
            animation: header-stuck both;
            animation-timeline: scroll(root block);
            animation-range: 0 2px;
        }
    }

    .profile {
        grid-column: content;
        grid-row: 1;
        justify-self: end;
        view-transition-name: profile-avatar;
        transition: margin-right 0.8s var(--spring-easing);

        &.breakout {
            grid-column: breakout;
            margin-right: 1rem;
        }

        .profile-button {
            anchor-name: --profile-button;
            width: 50px;
            height: 50px;
            padding: 0;
            overflow: clip;
            z-index: 100;

            &::before {
                z-index: -1;
            }

            img {
                width:100%;
                height:100%;
                object-fit: cover;
            }
        }

        [popover] {
            view-transition-name: profile-menu;
            background: none;
            padding: 0;
            position-anchor: --profile-button;
            position-area: bottom span-left;
            margin-top: 10px;
            color: inherit;
            overflow: clip;
            opacity: 0;
            transform: translateY(-60px) scale(0.9);
            transform-origin: center;
            width: 50px;
            min-width: 50px;
            height: 50px;
            border: 1px solid var(--glass-border-color-strong) !important;

            transition:
                display 0.8s allow-discrete,
                overlay 0.8s allow-discrete,
                opacity 0.5s ease-out,
                transform 0.8s var(--spring-easing),
                width 0.8s var(--spring-easing),
                min-width 0.8s var(--spring-easing),
                height 0.8s var(--spring-easing),
                border-radius 0.8s var(--spring-easing),
                filter 0.8s var(--spring-easing);

            ul {
                min-width: 210px;
            }

            &:popover-open {
                opacity: 1;
                transform: translateY(0) scale(1);
                width: auto;
                height: auto;
                filter: drop-shadow(var(--shadow-light));
                border: var(--glass-border);
                border-radius: var(--radius-medium);
                backdrop-filter: blur(var(--blur-standard));

                ul {
                    animation: droplet-pop 0.6s var(--spring-easing);
                }

                @starting-style {
                    opacity: 0;
                    transform: translateY(-60px) scale(0.9);
                    width: 50px;
                    min-width: 50px;
                    height: 50px;
                }
            }

            &::backdrop {
                background: none;
            }

            ul {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                list-style: none;
                padding: 0.2rem;
                margin: 0;
                gap: 0.2rem;
                transform-origin: center; /* Ensure droplet effect scales from center */

                &::after,
                &::before {
                    content: '';
                    position: absolute;
                    top: anchor(top);
                    left: anchor(left);
                    right: anchor(right);
                    height: anchor-size(height);
                    display: block;
                    background: none;
                    border-radius: var(--radius-medium);
                    transition:
                            top 1s var(--spring-easing),
                            left 1s var(--spring-easing),
                            right 1s var(--spring-easing),
                            height 1s var(--spring-easing),
                            opacity 1s var(--spring-easing),
                            transform 1s var(--spring-easing);
                    pointer-events: none;
                    transform-origin: center center;
                    animation-duration: 0.6s;
                    animation-timing-function: var(--spring-easing);
                    z-index: -1;
                }

                &::before {
                    background: var(--glass-panel-light);
                    box-shadow: var(--glass-edge);
                    view-transition-name: profile-selected-indicator;
                    position-anchor: --profile-selected;
                }

                &::after {
                    background: var(--glass-panel-dark);
                    position-anchor: --profile-hover;
                    opacity: 0;
                }

                &:not(:has(li a:hover, .theme-switch:hover)) {
                    anchor-name: --profile-hover;
                }

                &:has(li a:hover, .theme-switch:hover)::after {
                    opacity: 1;
                }

                &:has(li:nth-child(odd) :is(a:hover, .theme-switch:hover))::after,
                &:has(li:nth-child(odd).selected)::before {
                    animation-name: droplet-stretch-vertical;
                }

                &:has(li:nth-child(even) :is(a:hover, .theme-switch:hover))::after,
                &:has(li:nth-child(even).selected)::before {
                    animation-name: droplet-stretch-vertical-alt;
                }

                &:has(li :is(a, .theme-switch):active)::after {
                    transform: scale(0.8, 1.3);
                }
            }

            li {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                background: none;
                transition: color 0.3s ease;
                width: 100%;

                &.selected {
                    color: var(--color-red);
                    anchor-name: --profile-selected;
                }

                &:has(.theme-switch) {
                    justify-content: center;
                    padding: 4px 8px;
                    box-sizing: border-box;
                }
            }

            a {
                text-decoration: none;
                color: inherit;
                display: flex;
                padding: 15px 15px;
                width: 100%;
                height: 100%;
                align-items: center;
                justify-content: center;
                white-space: nowrap;

                &:hover {
                    anchor-name: --profile-hover;
                }
            }

            &::before {
                z-index: -1;
            }
        }
    }
</style>

<style is:global>
    /* View transitions, registered properties and keyframes cannot be scoped,
       so they are declared globally here next to the component that uses them. */

    /* Drives the header backdrop in browsers without scroll-state queries. */
    @property --header-stuck {
        syntax: '<custom-ident>';
        initial-value: false;
        inherits: true;
    }

    @keyframes header-stuck {
        from {
            --header-stuck: false;
        }
        to {
            --header-stuck: true;
        }
    }

    @keyframes droplet-stretch-vertical {
        0% {
            transform: scaleX(1);
            animation-timing-function: var(--spring-easing);
        }
        30% {
            transform: scaleX(0.8);
            animation-timing-function: var(--spring-easing);
        }
        60% {
            transform: scaleX(0.9);
            animation-timing-function: var(--spring-easing);
        }
        100% {
            transform: scaleX(1);
        }
    }

    @keyframes droplet-stretch-vertical-alt {
        0% {
            transform: scaleX(1);
            animation-timing-function: var(--spring-easing);
        }
        30% {
            transform: scaleX(0.8);
            animation-timing-function: var(--spring-easing);
        }
        60% {
            transform: scaleX(0.9);
            animation-timing-function: var(--spring-easing);
        }
        100% {
            transform: scaleX(1);
        }
    }

    @keyframes droplet-pop {
        0% {
            transform: scale(0.9);
        }
        40% {
            transform: scale(1.15, 0.85);
        }
        70% {
            transform: scale(0.95, 1.05);
        }
        100% {
            transform: scale(1);
        }
    }

    @keyframes profile-menu-exit {
        from {
            opacity: 1;
            transform: translateY(0) scale(1);
            filter: drop-shadow(var(--shadow-light));
            backdrop-filter: blur(var(--blur-standard));
        }
        to {
            opacity: 0;
            transform: translateY(-60px) scale(0.9);
            filter: drop-shadow(var(--shadow-light)) blur(2px);
            backdrop-filter: blur(var(--blur-standard));
        }
    }

    ::view-transition-group(back-button),
    ::view-transition-group(logo) {
        z-index: 1000;
    }

    ::view-transition-new(back-button) {
        animation: 300ms cubic-bezier(0, 0, 0.2, 1) both fade-in-down;
        animation-delay: 0.5s;
    }

    ::view-transition-old(back-button) {
        animation: 300ms cubic-bezier(0.4, 0, 1, 1) both fade-out-up;
    }

    ::view-transition-group(profile-selected-indicator) {
        animation-duration: 1s;
        animation-timing-function: var(--spring-easing);
        border-radius: var(--radius-medium);
        z-index: 1;
        overflow: hidden;
        backdrop-filter: blur(var(--blur-standard));
    }

    ::view-transition-old(profile-selected-indicator),
    ::view-transition-new(profile-selected-indicator) {
        animation: none;
        height: 100%;
        width: 100%;
        background: var(--glass-panel-light);
        box-shadow: var(--glass-edge);
        border-radius: inherit;
    }

    ::view-transition-group(profile-avatar) {
        z-index: 1002;
        backdrop-filter: blur(var(--blur-standard));
    }

    ::view-transition-group(profile-menu) {
        animation-duration: 0.8s;
        animation-timing-function: var(--spring-easing);
        backdrop-filter: none !important;
    }

    ::view-transition-old(profile-menu) {
        animation: 0.8s var(--spring-easing) both profile-menu-exit;
        backdrop-filter: none !important;
    }

    ::view-transition-new(profile-menu) {
        animation: none;
        opacity: 0;
        backdrop-filter: none !important;
    }
</style>
