---
---
<ul class="search-results skeleton">
    {[1, 2, 3].map((_) => (
        <li class="card radius-large glass-container-mild skeleton-card">
            <div class="skeleton-image radius-large"></div>
            <div class="details">
                <div class="skeleton-title"></div>
                <div class="skeleton-rating"></div>
                <div class="skeleton-text"></div>
                <div class="skeleton-text short"></div>
                <div class="skeleton-cast">
                    <div class="skeleton-cast-member"></div>
                    <div class="skeleton-cast-member"></div>
                </div>
            </div>
        </li>
    ))}
</ul>

<style>
    .skeleton-card {
        min-height: 250px;
        position: relative;
        overflow: hidden;
    }

    .skeleton-image {
        width: 175px;
        height: 250px;
        background: rgba(255, 255, 255, 0.05);
    }

    .skeleton-title {
        height: 1.5rem;
        width: 60%;
        background: rgba(255, 255, 255, 0.05);
        margin-bottom: 0.5rem;
        border-radius: 4px;
    }

    .skeleton-rating {
        height: 1rem;
        width: 30px;
        background: rgba(255, 255, 255, 0.05);
        margin-bottom: 1rem;
        border-radius: 4px;
    }

    .skeleton-text {
        height: 1rem;
        width: 90%;
        background: rgba(255, 255, 255, 0.05);
        margin-bottom: 0.5rem;
        border-radius: 4px;
    }

    .skeleton-text.short {
        width: 40%;
    }

    .skeleton-cast {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .skeleton-cast-member {
        height: 2.5rem;
        width: 80px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
    }

    .skeleton-card::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        transform: translateX(-100%);
        background-image: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0) 0,
            rgba(255, 255, 255, 0.03) 20%,
            rgba(255, 255, 255, 0.05) 60%,
            rgba(255, 255, 255, 0)
        );
        animation: shimmer 2s infinite;
    }

    @keyframes shimmer {
        100% {
            transform: translateX(100%);
        }
    }
</style>
