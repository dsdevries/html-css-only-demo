---
---

<div class="theme-switch" role="radiogroup" aria-label="Theme">
    <label class="theme-option" for="theme-light" title="Light mode">
        <input type="radio" name="theme" id="theme-light" value="light">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <span>Light</span>
    </label>
    <label class="theme-option" for="theme-system" title="System mode">
        <input type="radio" name="theme" id="theme-system" value="system" checked>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="14" x="2" y="3" rx="2"/>
            <line x1="8" x2="16" y1="21" y2="21"/>
            <line x1="12" x2="12" y1="17" y2="21"/>
        </svg>
        <span>System</span>
    </label>
    <label class="theme-option" for="theme-dark" title="Dark mode">
        <input type="radio" name="theme" id="theme-dark" value="dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <span>Dark</span>
    </label>
</div>

<style>
    .theme-switch {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 3px;
        width: 100%;
        background: var(--glass-mild-bg);
        border-radius: var(--radius-large);
        box-shadow: var(--glass-edge);
        box-sizing: border-box;
        gap: 2px;

        &:hover {
            anchor-name: --profile-hover;
        }

        &::before,
        &::after {
            content: '';
            position: absolute;
            top: anchor(top);
            left: anchor(left);
            right: anchor(right);
            height: anchor-size(height);
            display: block;
            background: none;
            border-radius: var(--radius-medium);
            transition:
                left 1s var(--spring-easing),
                right 1s var(--spring-easing),
                top 1s var(--spring-easing),
                height 1s var(--spring-easing),
                opacity 1s var(--spring-easing),
                transform 1s var(--spring-easing);
            pointer-events: none;
            transform-origin: center center;
            animation-duration: 0.6s;
            animation-timing-function: linear;
            z-index: 0;
        }

        &::before {
            background: var(--glass-panel-light);
            box-shadow: var(--glass-edge);
            position-anchor: --theme-selected;
        }

        &::after {
            background: var(--glass-panel-dark);
            position-anchor: --theme-hover;
            opacity: 0;
        }

        &:not(:has(.theme-option:hover)) {
            anchor-name: --theme-hover;
        }

        &:not(:has(.theme-option:hover)):hover {
            anchor-name: --profile-hover, --theme-hover;
        }

        &:has(.theme-option:hover)::after {
            opacity: 1;
        }

        &:has(.theme-option:nth-child(odd):hover)::after,
        &:has(.theme-option:nth-child(odd):has(input:checked))::before {
            animation-name: droplet-stretch;
        }

        &:has(.theme-option:nth-child(even):hover)::after,
        &:has(.theme-option:nth-child(even):has(input:checked))::before {
            animation-name: droplet-stretch-alt;
        }

        &:has(.theme-option:active)::after {
            transform: scale(1.15);
        }

        .theme-option {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 6px 4px;
            border-radius: var(--radius-medium);
            cursor: pointer;
            user-select: none;
            color: inherit;
            font-size: 0.75rem;
            font-weight: 500;
            transition:
                color 0.3s var(--spring-easing),
                opacity 0.3s var(--spring-easing);
            white-space: nowrap;

            input[type="radio"] {
                position: absolute;
                opacity: 0;
                width: 0;
                height: 0;
                pointer-events: none;
                margin: 0;
            }

            svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }

            &:hover {
                anchor-name: --theme-hover;
            }

            &:has(input:checked) {
                color: var(--color-red);
                text-shadow: none;
                anchor-name: --theme-selected;
            }
        }
    }
</style>

<script>
    function initTheme(): void {
        const lightInput = document.getElementById('theme-light') as HTMLInputElement | null;
        const systemInput = document.getElementById('theme-system') as HTMLInputElement | null;
        const darkInput = document.getElementById('theme-dark') as HTMLInputElement | null;
        const themeInputs = document.querySelectorAll<HTMLInputElement>('input[name="theme"]');

        if (themeInputs.length === 0) {
            return;
        }

        const applyTheme = (): void => {
            const savedTheme = localStorage.getItem('theme') || 'system';
            if (savedTheme === 'dark' && darkInput) {
                darkInput.checked = true;
            } else if (savedTheme === 'light' && lightInput) {
                lightInput.checked = true;
            } else if (systemInput) {
                systemInput.checked = true;
            }
            document.documentElement.dataset.theme = savedTheme;
        };

        // 1. Initialize radio state from localStorage or default to system
        applyTheme();

        // 2. Persist manual changes to localStorage
        themeInputs.forEach((input) => {
            input.addEventListener('change', () => {
                if (input.checked) {
                    const value = input.value;
                    localStorage.setItem('theme', value);
                    document.documentElement.dataset.theme = value;
                }
            });
        });

        // 3. Sync state if restored from back-forward cache
        window.addEventListener('pageshow', applyTheme);

        // 4. Sync state across browser tabs/windows
        window.addEventListener('storage', (e: StorageEvent) => {
            if (e.key === 'theme') {
                applyTheme();
            }
        });
    }

    initTheme();

    document.addEventListener('astro:page-load', initTheme);
</script>
