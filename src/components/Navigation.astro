---
interface Props {
  currentNav?: 'featured' | 'new' | 'categories' | 'search';
}

const { currentNav = 'featured' } = Astro.props;
---

<nav class="main-nav glass-container">
    <ul>
        <li class:list={[{ selected: currentNav === 'featured' }]}><a href="/">Featured</a></li>
        <li class:list={[{ selected: currentNav === 'new' }]}><a href="/new">New</a></li>
        <li class:list={[{ selected: currentNav === 'categories' }]}><a href="/categories">Categories</a></li>
        <li class:list={[{ selected: currentNav === 'search' }]}><a href="/search">Search</a></li>
    </ul>
</nav>

<style>
    .main-nav {
        view-transition-name: main-nav;
        z-index: 10;
        position: fixed;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);

        ul {
            display: flex;
            flex-direction: row;
            align-items: center;
            list-style: none;
            padding: 0.2rem;
            margin: 0;

            &::after,
            &::before {
                content: '';
                position: absolute;
                top: anchor(top);
                left: anchor(left);
                right: anchor(right);
                height: anchor-size(height);
                display: block;
                background: none;
                border-radius: var(--radius-medium);
                transition:
                        left 1s var(--spring-easing),
                        right 1s var(--spring-easing),
                        top 1s var(--spring-easing),
                        height 1s var(--spring-easing),
                        opacity 1s var(--spring-easing),
                        transform 1s var(--spring-easing);
                pointer-events: none;
                transform-origin: center center;
                animation-duration: 0.6s;
                animation-timing-function: linear;
                z-index: -1;
            }

            &::before {
                background: var(--glass-panel-light);
                box-shadow: var(--glass-edge);
                view-transition-name: selected-indicator;
                position-anchor: --selected;
            }

            &::after {
                background: var(--glass-panel-dark);
                position-anchor: --hover;
                opacity: 0;
            }

            &:not(:has(li a:hover)) {
                anchor-name: --hover;
            }

            &:has(li a:hover)::after {
                opacity: 1;
            }

            &:has(li:nth-child(odd) a:hover)::after,
            &:has(li:nth-child(odd).selected)::before {
                animation-name: droplet-stretch;
            }

            &:has(li:nth-child(even) a:hover)::after,
            &:has(li:nth-child(even).selected)::before {
                animation-name: droplet-stretch-alt;
            }

            &:has(li a:active)::after {
                transform: scale(1.3);
            }
        }

        li {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            transition: color 0.3s ease;

            &:nth-child(1) {
                view-transition-name: nav-item-1;
            }

            &:nth-child(2) {
                view-transition-name: nav-item-2;
            }

            &:nth-child(3) {
                view-transition-name: nav-item-3;
            }

            &:nth-child(4) {
                view-transition-name: nav-item-4;
            }

            &.selected {
                color: var(--color-red);
                text-shadow: none;
                anchor-name: --selected;
            }
        }

        a {
            text-decoration: none;
            color: inherit;
            display: flex;
            padding: 15px 15px;
            width: 100%;
            height: 100%;
            align-items: center;
            justify-content: center;

            &:hover {
                anchor-name: --hover;
            }
        }

        /* The next sibling is the page content, so it has to be global */
        & + :global(*) {
            margin-bottom: 100px;
        }
    }
</style>

<style is:global>
    /* View transitions and keyframes cannot be scoped, so they are declared
       globally here next to the component that uses them. */

    @keyframes hover-indicator-out {
        0% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    ::view-transition-image-pair(selected-indicator),
    ::view-transition-old(selected-indicator),
    ::view-transition-new(selected-indicator) {
        animation: none;
        opacity: 0;
        visibility: hidden;
    }

    ::view-transition-group(selected-indicator) {
        animation-duration: 1s;
        animation-timing-function: var(--spring-easing);
        border-radius: var(--radius-medium);
        z-index: 11;
    }

    ::view-transition-group(selected-indicator) {
        background: var(--glass-panel-light);
        box-shadow: var(--glass-edge);
    }

    ::view-transition-group(nav-item-1),
    ::view-transition-group(nav-item-2),
    ::view-transition-group(nav-item-3),
    ::view-transition-group(nav-item-4) {
        z-index: 12;
    }

    ::view-transition-group(main-nav) {
        border-radius: var(--radius-large);
        z-index: 10;
    }
</style>
