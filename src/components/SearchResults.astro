---
import movies from '../data/movies.json';
import MovieCard from './MovieCard.astro';

interface Props {
    query: string;
}

const { query } = Astro.props;

// Artificial delay to demonstrate streaming
await new Promise(resolve => setTimeout(resolve, 1500));

const filteredMovies = movies.filter((movie) => {
    if (!query) return true;
    const searchString = `${movie.title} ${movie.description} ${movie.genre} ${movie.cast.map(c => c.name).join(' ')}`.toLowerCase();
    return searchString.includes(query.toLowerCase());
});
---
<div class="search-results results-list">
    {filteredMovies.length === 0 ? (
        <p id="no-results" style="padding: 2rem; text-align: center; opacity: 0.7;">No movies found matching your search.</p>
    ) : (
        filteredMovies.map((movie) => (
            <MovieCard 
                movie={movie} 
                class="glass-container-mild" 
                loading="eager"
            />
        ))
    )}
    <span class="results-done" style="display:none;"></span>
</div>
