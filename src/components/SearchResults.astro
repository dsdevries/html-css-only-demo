---
import movies from '../data/movies.json';

interface Props {
    query: string;
}

const { query } = Astro.props;

// Artificial delay to demonstrate streaming
await new Promise(resolve => setTimeout(resolve, 2000));

const filteredMovies = movies.filter((movie) => {
    if (!query) return true;
    const searchString = `${movie.title} ${movie.description} ${movie.genre} ${movie.cast.map(c => c.name).join(' ')}`.toLowerCase();
    return searchString.includes(query.toLowerCase());
});
---

{filteredMovies.length === 0 ? (
    <p id="no-results" style="padding: 2rem; text-align: center; opacity: 0.7;">No movies found matching your search.</p>
) : (
    <ul class="search-results">
        {filteredMovies.map((movie) => (
            <li id={movie.slug} class="card radius-large glass-container-mild" style={`--movie-transition-name: movie-${movie.slug};`}>
                <a href={`/detail/${movie.slug}`}>
                    <img src={movie.image} alt={movie.title} />
                </a>
                <div class="details">
                    <h3>{movie.title}</h3>
                    <div class="rating">{movie.rating}</div>
                    <p>
                        {movie.description}
                    </p>
                    <div class="cast">
                        {movie.cast.map((member) => (
                            <div>
                                <div class="name">{member.name}</div>
                                <div class="role">{member.role}</div>
                            </div>
                        ))}
                    </div>
                </div>
            </li>
        ))}
    </ul>
)}
