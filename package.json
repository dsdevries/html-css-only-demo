{
  "name": "html-only website",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && lightningcss --bundle --targets '>= 0.25%' src/styles.css -o dist/styles.css",
    "start": "npm run build && node dist/server.js",
    "watch": "nodemon --watch src -e ts,html,css --exec \"npm run build && node dist/server.js\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/connect-livereload": "^0.6.3",
    "@types/express": "^5.0.6",
    "@types/livereload": "^0.9.5",
    "connect-livereload": "^0.6.1",
    "lightningcss-cli": "^1.33.0",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14",
    "typescript": "^5.5.3"
  },
  "private": true
}
